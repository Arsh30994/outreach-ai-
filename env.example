# --- Required for real discovery ---
YOUTUBE_API_KEY=

# --- Optional: LLM personalization (falls back to a clearly-labelled offline composer) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Sending (safe by default) ---
DRY_RUN=true
# If set and DRY_RUN=false, every live email is redirected to this address (recommended for the demo)
SEND_TEST_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=       # use an app password, never your main password
SMTP_FROM=
