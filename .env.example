# Copy to .env and fill in local secrets. Never commit .env.

# Required before live YouTube discovery. Not required for init-db, status, or quota.
YOUTUBE_API_KEY=

# Optional. Classification and message generation fall back offline when this is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# dry_run (default), test, or live. test requires SEND_TEST_EMAIL_TO.
# live requires GMAIL_CREDENTIALS_FILE and GMAIL_TOKEN_FILE.
OUTREACH_MODE=dry_run
SEND_TEST_EMAIL_TO=

# Paths to OAuth client secrets and the user token. Keep both outside git.
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
